# A single fani run. Install as a user unit:
#
#   mkdir -p ~/.config/systemd/user
#   cp systemd/fani.{service,timer} ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now fani.timer
#
# Check on it with `systemctl --user list-timers fani.timer` and
# `journalctl --user -u fani.service -n 50`.

[Unit]
Description=Translate documentation that is out of date
Documentation=https://github.com/koko-t7i/fani
# Built-in providers require the network; custom Agents may also require it.
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h
ExecStart=%h/.local/bin/fani sync --config %h/.config/fani/fani.toml --report-dir %h/.local/state/fani/reports

# Built-in providers and custom Agents read credentials from here. Keep this
# user-owned file outside the repository with mode 600.
EnvironmentFile=-%h/.config/fani/env

# A run is bounded by max_tasks, but an agent that hangs past its own timeout
# should not hold the schedule forever.
TimeoutStartSec=2h

# Explicitly terminate every Agent provider descendant when the service stops.
KillMode=control-group

# Exit codes are the interface: 0 nothing to do or done, 1 needs a human,
# 2 broken, 3 partial (more chunks remain). Only 2 counts as a failure worth
# alerting on; 1 and 3 are normal outcomes that the report explains.
SuccessExitStatus=0 1 3

# Add every configured repository and report/state parent here. Prefixing a
# path with "-" allows installation before that directory has been created.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=-%h/.local/state/fani -%h/code

[Install]
WantedBy=default.target
